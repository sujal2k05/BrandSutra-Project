# BrandSutra Root Environment Variables Template
# Copy this file to .env and configure your local credentials

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3307
DB_NAME=brandsutra_db
DB_USERNAME=root
DB_PASSWORD=your_database_password_here
DB_ROOT_PASSWORD=your_mysql_root_password_here

# Spring Boot Configuration
PORT=8080
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long_here
JWT_EXPIRATION=86400000

# AI Microservice Configuration
AI_PORT=8000
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=your_internal_ai_service_secret_token_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api

